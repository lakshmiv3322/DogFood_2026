# DOGFOOD 2026 — environment variables template
# Copy this to .env and fill in real values. Never commit .env.

# PostgreSQL credentials (used by the db service)
POSTGRES_USER=dogfood
POSTGRES_PASSWORD=             # generate: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_DB=dogfood2026

# Full Prisma connection URL (must match POSTGRES_* above)
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>

# Session signing secret — must be a long random string
NEXTAUTH_SECRET=               # generate: python -c "import secrets; print(secrets.token_hex(32))"
